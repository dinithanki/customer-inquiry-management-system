
PORT=5000

# PostgreSQL Database
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_NEON_HOST/YOUR_DB_NAME?sslmode=require"

# Initial Admin Account
INITIAL_ADMIN_NAME="System Administrator"
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="CHANGE_THIS_INITIAL_PASSWORD"

# JWT Authentication
JWT_ACCESS_SECRET="REPLACE_WITH_A_SECURE_RANDOM_SECRET"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
